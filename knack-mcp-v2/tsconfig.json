{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts"]
}
