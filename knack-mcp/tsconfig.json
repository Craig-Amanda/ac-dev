{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true
    },
    "// include": "Scoped to src so scripts/ (run with tsx, never built) is not compiled.",
    "include": ["src"]
}
